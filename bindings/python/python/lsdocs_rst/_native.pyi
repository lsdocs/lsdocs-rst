# Type stubs for the native module (src/lib.rs). Trees and settings cross
# as dicts; the package's __init__.py wraps them.

from collections.abc import Callable, Mapping
from typing import Any

class NativeContext:
    @property
    def name(self) -> str: ...
    @property
    def arguments(self) -> list[str]: ...
    @property
    def options(self) -> dict[str, Any]: ...
    @property
    def content(self) -> list[str]: ...
    @property
    def lineno(self) -> int: ...
    @property
    def block_text(self) -> str: ...
    @property
    def span(self) -> dict[str, int] | None: ...
    @property
    def in_substitution(self) -> bool: ...
    def parse_content(self, container: dict[str, Any]) -> dict[str, Any]: ...
    def parse_inline(self, text: str) -> tuple[list[dict[str, Any]], list[dict[str, Any]]]: ...
    def message(self, level: int, text: str) -> dict[str, Any]: ...

class NativeParser:
    def __init__(
        self,
        *,
        source: str | None = None,
        transforms: bool = False,
        keep_unknown_directives: bool = False,
        settings: Mapping[str, Any] | None = None,
        directives: Mapping[str, tuple[dict[str, Any], Callable[[NativeContext], tuple[Any, ...]]]]
        | None = None,
        roles: Mapping[str, Callable[[dict[str, Any]], tuple[Any, ...]]] | None = None,
        root: str | None = None,
        files: Callable[[str], bytes | str] | None = None,
        urls: Callable[[str], bytes | str] | None = None,
    ) -> None: ...
    def settings(self) -> dict[str, Any]: ...
    def parse(self, text: str) -> tuple[dict[str, Any], list[dict[str, Any]]]: ...

def pformat(tree: dict[str, Any]) -> str: ...
def to_xml(tree: dict[str, Any], options: Mapping[str, bool] | None = None) -> str: ...
def make_id(name: str) -> str: ...
def default_settings() -> dict[str, Any]: ...
