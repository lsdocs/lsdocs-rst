-- The rockspec template: lsdocs/.github's build-rocks.yml writes
-- lsdocs-rst-<version>-1.rockspec from it, @VERSION@ being the version of the
-- lsdocs-rst-lua crate and @SHA256@ the SHA-256 of each prebuilt module it
-- built (one `["<lua>-<target>"] = "<hash>",` line per archive).
--
-- luarocks-build-lsdocs-prebuilt (lsdocs/.github) installs the prebuilt
-- module attached to the release for this Lua and platform, and builds
-- from source with cargo (luarocks-build-rust-mlua) when there is none.
rockspec_format = "3.0"
package = "lsdocs-rst"
version = "@VERSION@-1"

source = {
  url = "git+https://github.com/lsdocs/lsdocs-rst",
  tag = "lsdocs-rst-lua/v@VERSION@",
}

description = {
  summary = "A fast reStructuredText parser that builds docutils' document tree.",
  detailed = [[
A Rust port of docutils' reStructuredText parser and transforms. The tree
comes back as plain Lua tables, with the source position of every node.
]],
  homepage = "https://github.com/lsdocs/lsdocs-rst",
  license = "Apache-2.0 OR MIT",
}

-- Lua 5.4 and LuaJIT (5.1 API).
dependencies = {
  "lua >= 5.1",
}

build_dependencies = {
  "luarocks-build-lsdocs-prebuilt",
}

build = {
  type = "lsdocs-prebuilt",
  url = "https://github.com/lsdocs/lsdocs-rst/releases/download/lsdocs-rst-lua%2Fv@VERSION@",
  sha256 = {
@SHA256@
  },
  modules = {
    -- require("lsdocs_rst") <- the lsdocs_rst_lua library.
    ["lsdocs_rst"] = "lsdocs_rst_lua",
  },
  default_features = false,
  features = { "module" },
}
